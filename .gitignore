.tools/


# ============================================================
# Generated Source Files
# ============================================================

# DO NOT globally ignore *.g.dart or *.freezed.dart.
#
# Flutter projects often generate these files, but whether they
# should be committed depends on your project architecture.
#
# If your project intentionally does NOT commit generated files,
# add these rules:
#
# **/*.g.dart
# **/*.freezed.dart


